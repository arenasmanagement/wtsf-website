# ═══════════════════════════════════════════════════════════════════
# WEST TENNESSEE STATE FAIR — Required Environment Variables
# Copy this file to .env.local and fill in all values.
# .env.local is gitignored and never committed.
# Set these same variables in Vercel: Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # Server-only, never expose to browser

# ── Resend (email) ──────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=exhibits@wtsfair.com   # Must be a verified domain in Resend
                                          # Or use onboarding@resend.dev for testing

# ── Admin dashboard ─────────────────────────────────────────────────
# Pick a strong password and a random 32+ character secret
ADMIN_PASSWORD=choose_a_strong_password_here
ADMIN_SECRET=a_random_32_or_more_character_secret_for_signing_sessions

# ── Partner / Vendor / Sponsor Forms ───────────────────────────────
# Recipient email for all vendor and sponsor application submissions.
# Set this to the fair's preferred email address before enabling forms.
# REQUIRED — forms will return a 503 error if this is not set.
PARTNERSHIP_FORM_RECIPIENT_EMAIL=your-recipient-email@example.com

# ── Volunteer Forms ──────────────────────────────────────────────────────────
# Recipient email for volunteer interest form submissions.
# If not set, falls back to PARTNERSHIP_FORM_RECIPIENT_EMAIL above.
# Set to a different address to route volunteer forms separately.
# REQUIRED (or set PARTNERSHIP_FORM_RECIPIENT_EMAIL) — forms return 503 if neither is set.
VOLUNTEER_FORM_RECIPIENT_EMAIL=your-recipient-email@example.com

# ── App URL ─────────────────────────────────────────────────────────
# Used in emails for links back to the site
NEXT_PUBLIC_SITE_URL=https://wtsf-website-pz0apszol-amco2.vercel.app
# Change to https://www.wtsfair.com once domain is connected
