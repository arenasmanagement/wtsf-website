# ═══════════════════════════════════════════════════════════════════
# WEST TENNESSEE STATE FAIR — Required Environment Variables
# Copy this file to .env.local and fill in all values.
# .env.local is gitignored and never committed.
# Set these same variables in Vercel: Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────
# Get these from: supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # Server-only, never expose to browser

# ── Resend (email) ──────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=exhibits@wtsfair.com   # Must be a verified domain in Resend
                                          # Or use onboarding@resend.dev for testing

# ── Admin dashboard ─────────────────────────────────────────────────
# Pick a strong password and a random 32+ character secret
ADMIN_PASSWORD=choose_a_strong_password_here
ADMIN_SECRET=a_random_32_or_more_character_secret_for_signing_sessions

# ── Partner / Vendor / Sponsor Forms ───────────────────────────────
# ── Vendor / Sponsor / Volunteer Form Recipients ─────────────────────────────
# Email routing — each form type goes to a different address.
# Defaults are hardcoded in the routes; set these only to override.

# Commercial vendor applications (non-food, routed to fair coordinator)
VENDOR_FORM_RECIPIENT_EMAIL=luke.weaver16@yahoo.com

# Food vendor inquiries — coordinator emails are stored in lib/vendor-config.ts
# (FOOD_VENDOR_COORDINATORS array) — no env var needed.

# Sponsor applications — comma-separated for multiple recipients
SPONSOR_FORM_RECIPIENT_EMAILS=luke.weaver16@yahoo.com,butlerdr202@gmail.com

# Volunteer form submissions
VOLUNTEER_FORM_RECIPIENT_EMAIL=wtsfair@gmail.com

# ── Fair Updates (subscriber notification system) ──────────────────
# No additional env vars required — uses RESEND_API_KEY and RESEND_FROM_EMAIL above.
# Run supabase/updates-schema.sql in your Supabase SQL editor to create
# the subscribers and announcements tables before using this feature.

# ── App URL ─────────────────────────────────────────────────────────
# Used in emails for links back to the site.
# Use the production domain once connected; use your Vercel preview URL for staging.
NEXT_PUBLIC_SITE_URL=https://www.wtsfair.com

# ── Upstash Redis (rate limiting) ───────────────────────────────────
# Required for production-safe rate limiting on API routes.
# Without these, the app falls back to in-memory rate limiting
# which resets on every Vercel cold start (not safe for production).
#
# Setup:
#   1. Create a free Redis database at console.upstash.com
#   2. Copy the REST URL and REST Token from the database dashboard
#   3. Add both values to Vercel: Settings → Environment Variables
#
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_REGION.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# ── Google Analytics 4 ──────────────────────────────────────────────
# Set this to activate sitewide GA4 tracking. Without it, analytics is dormant.
# Get from: analytics.google.com → Admin → Data Streams → Web → Measurement ID
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── WTSF Got Talent ─────────────────────────────────────────────────
# Square location for Got Talent payments — WTSF location (NOT Pageants).
# Server-side (used in API routes). Do NOT change SQUARE_LOCATION_ID (Pageants).
GOT_TALENT_SQUARE_LOCATION_ID=2JG1375GZ9TDQ

# Client-side Square location for Got Talent Web Payments SDK.
# Same value as above — required because client env vars need the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_GOT_TALENT_SQUARE_LOCATION_ID=2JG1375GZ9TDQ

# Donna's email address — receives notification email when a Got Talent registration is confirmed.
# Leave blank to skip the admin notification (confirmation to registrant still sends).
GOT_TALENT_ADMIN_EMAIL=

# Registration open/closed master switch (defaults to "true" if unset).
# Set to "false" to close registration without touching the DB.
# GOT_TALENT_REGISTRATION_ENABLED=false
